@model GuideMe.Models.Group

@{
    ViewData["Title"] = "Create Group";
}

<h2>Create a New Group</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    <div class="form-group">
        <label for="Name">Group Name</label>
        <input type="text" id="Name" name="Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Location">Location</label>
        <input type="text" id="Location" name="Location" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="TravelStartDate">Travel Start Date</label>
        <input type="date" id="TravelStartDate" name="TravelStartDate" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="TravelEndDate">Travel End Date</label>
        <input type="date" id="TravelEndDate" name="TravelEndDate" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea id="Description" name="Description" class="form-control" rows="4" required></textarea>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Create Group</button>
    </div>
</form>
