@model GuideMe.Models.Group

@{
    ViewData["Title"] = "Create Group";
}

<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>

<form asp-action="Create" enctype="multipart/form-data" method="post" style="max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f9f9f9; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">

    <h2 style="text-align: center; color: #4b8f8c; font-size: 1.4rem;">Create a New Group</h2>
    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Name" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-users" style="margin-right: 10px; color: #4b8f8c;"></i> Group Name
        </label>
        <input type="text" id="Name" name="Name" class="form-control" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Location" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-map-marker-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Location
        </label>
        <input type="text" id="Location" name="Location" class="form-control" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="TravelStartDate" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-calendar-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Travel Start Date
        </label>
        <input type="date" id="TravelStartDate" name="TravelStartDate" class="form-control" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="TravelEndDate" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-calendar-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Travel End Date
        </label>
        <input type="date" id="TravelEndDate" name="TravelEndDate" class="form-control" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Description" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-comment-dots" style="margin-right: 10px; color: #4b8f8c;"></i> Description
        </label>
        <textarea id="Description" name="Description" class="form-control" style="width: 100%; padding: 10px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" rows="4" required></textarea>
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <button type="submit" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.9rem; border-radius: 5px; background-color: #4b8f8c; color: white; border: none; cursor: pointer; display: inline-flex; align-items: center; width: 100%;">
            <i class="fas fa-plus-circle" style="margin-right: 8px;"></i> Create Group
        </button>
    </div>
</form>
