@model IEnumerable<GuideMe.Models.Group>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


<h2 class="text-center text-primary">Available Groups</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-end mb-3">
    <a asp-controller="GroupFormation" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Create Group
    </a>
</div>

<div class="group-container">
    @foreach (var group in Model)
    {
        <div class="group-box">
            <h4 class="group-title"><i class="fas fa-users"></i> @group.Name</h4>
            <p><i class="fas fa-map-marker-alt"></i> @group.Location</p>
            <p><i class="fas fa-calendar-alt"></i> @group.TravelStartDate - @group.TravelEndDate</p>
            <p><i class="fas fa-map-marked-alt"></i> @group.Description</p>

            <div class="group-actions">
                @if (ViewData["JoinedGroups"] != null && ((List<int>)ViewData["JoinedGroups"]).Contains(group.GroupId))
                {
                    <div class="action-buttons">
                        <a asp-action="Edit" asp-controller="GroupFormation" asp-route-groupId="@group.GroupId" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Leave" asp-controller="GroupFormation" asp-route-groupId="@group.GroupId" class="btn btn-danger">
                            <i class="fas fa-sign-out-alt"></i> Leave
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="Join" asp-controller="GroupFormation" method="post">
                        <input type="hidden" name="groupId" value="@group.GroupId" />
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-user-plus"></i> Join
                        </button>
                    </form>
                }
            </div>
        </div>
    }
</div>

<!-- Chat Section -->
<div class="chat-section">
    @foreach (var group in Model)
    {
        @if (ViewData["JoinedGroups"] != null && ((List<int>)ViewData["JoinedGroups"]).Contains(group.GroupId))
        {
            <h4 class="text-center text-primary">Group Chat</h4>
            <div class="chat-container">
                <div class="group-info">
                    <h5><i class="fas fa-users"></i> @group.Name</h5>
                    <ul class="members-list">
                        @foreach (var member in group.GroupMembers)
                        {
                            <li>
                                <img src="@(!string.IsNullOrEmpty(member.User.UserImage)
                                          ? Url.Content("~/UserFile/" + member.User.UserImage)
                                          : Url.Content("~/UserFile/default-profile.jpg"))"
                                     alt="@member.User.Name's Profile Image" class="profile-img" />
                                <span>@member.User.Name</span>
                            </li>
                        }
                    </ul>


                </div>

                <div class="chat-box-container">
                    <div id="chatMessages-@group.GroupId" class="chat-box"></div>
                    <div class="chat-input">
                        <input type="text" id="messageInput-@group.GroupId" placeholder="Type a message..." />
                        <label for="fileInput-@group.GroupId" class="file-label">
                            <i class="fas fa-paperclip"></i>
                            <span class="file-count"></span>
                        </label>
                        <input type="file"
                               id="fileInput-@group.GroupId"
                               multiple
                               class="file-input"
                               accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
                        <button onclick="sendMessage(@group.GroupId)" class="send-btn">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
               
            </div>
        }
    }
</div>

<style>

    body {
        font-family: 'Bebas Neue', cursive;
        background-color: #f8f9fa;
        margin: 0;
        padding: 0;
    }

    /* Center the "Available Groups" heading */
    h2.text-center.text-primary {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin-bottom: 20px;
        color: #4b8f8c; /* Softer greenish-blue for headings */
    }

    /* Container for the "Create Group" button aligned to the right */
    .text-end.mb-3 {
        position: absolute;
        right: 20px;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 210px;
    }

    .group-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Two columns */
        gap: 20px;
        margin-top: 20px;
    }

    .group-box {
        background: #ffffff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.1);
        text-align: center;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        /* Hover effect for group box */
        .group-box:hover {
            transform: scale(1.05);
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.15);
        }


    .group-box p {
        font-size: 20px;
        color: #555555; /* Softer gray for paragraph text */
        margin: 8px 0;
    }

    .group-box i {
        font-size: 26px;
        margin-right: 8px;
        color: #4b8f8c; /* Softer blue for icons */
    }

    /* Action Buttons */
    .action-buttons a,
    .action-buttons form button {
        display: inline-block;
        padding: 12px 20px;
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s ease-in-out;
        width: 160px;
        border: 2px solid transparent;
    }

    /* Buttons with softened colors */
    .btn-warning {
        background-color: #f1c232; /* Soft yellow */
        color: #333333;
        border-color: #e0a800;
    }

        .btn-warning:hover {
            background-color: #e0a800; /* Slight darkened yellow */
            color: white;
        }

    .btn-danger {
        background-color: #c93e3e; /* Softer red */
        color: white;
        border-color: #b83232;
    }

        .btn-danger:hover {
            background-color: #b83232; /* Slight darkened red */
        }

    .btn-success {
        background-color: #6fa44d; /* Softer green */
        color: white;
        border-color: #5c8b3e;
    }

        .btn-success:hover {
            background-color: #5c8b3e; /* Slight darkened green */
        }

    /* Chat Section Styling */
    .chat-section {
        margin-top: 30px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Chat Container */
    .chat-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        width: 90%;
        max-width: 1200px;
        background-color: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .chat-section h4 {
        color: #4b8f8c;
    font-size: 2rem; /* Increased font size */
    margin-bottom: 20px;
    }

    /* Group Info (Left Side) */
    .group-info {
        width: 30%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding-right: 20px;
        border-right: 2px solid #ddd;
        margin-top: 0;
    }

        .group-info h5 {
            color: #4b8f8c; /* Softer blue for group name */
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

    /* Members List Styling */
    .members-list li {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 8px;
    }

    .members-list .profile-img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        margin-right: 10px;
    }

    .members-list span {
        font-size: 1.1rem;
        color: #333; /* Softer dark gray for member names */
    }

    /* Chat Box Container (Right Side) */
    .chat-box-container {
        width: 65%;
        padding-left: 20px;
    }

    /* Chat Box */
    .chat-box {
        height: 500px;
        overflow-y: auto;
        border: 1px solid #ddd;
        padding: 15px;
        background: #f1f1f1; /* Soft light gray */
        margin-bottom: 15px;
        border-radius: 8px;
        box-shadow: inset 0px 2px 5px rgba(0, 0, 0, 0.05);
    }

    /* Input Area for Sending Messages */
    .chat-input input[type="text"] {
        flex-grow: 1;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 1.1rem;
        margin-right: 10px;
        width: 85%;
    }

    .chat-input .file-label {
        cursor: pointer;
        margin-left: 10px;
        font-size: 1.3rem;
    }

    .chat-input .file-input {
        display: none;
    }

    .chat-input .send-btn {
        padding: 12px;
        background-color: #4b8f8c; /* Softer blue for the send button */
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1.3rem;
    }

        .chat-input .send-btn:hover {
            background-color: #3a6e68; /* Slight darkened blue */
        }

    .message-attachments {
        margin-top: 10px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .image-attachment img {
        max-width: 200px;
        max-height: 200px;
        border-radius: 8px;
        cursor: pointer;
        transition: transform 0.2s;
        position: relative;
        display: inline-block;
        margin: 5px;
    }

        .image-attachment img {
            max-width: 200px;
            max-height: 200px;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.2s;
        }

    .image-actions {
        position: absolute;
        top: 5px;
        right: 5px;
        display: none;
        background: rgba(0, 0, 0, 0.7);
        border-radius: 4px;
        padding: 5px;
        z-index: 100;
        flex-direction: row;
        gap: 10px;
    }

    .image-attachment:hover .image-actions {
        display: flex;
    }

    .action-btn {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        padding: 5px;
        font-size: 16px;
        transition: color 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .action-btn:hover {
            color: #ffd700;
            transform: scale(1.1);
        }

    .message-attachments {
        margin-top: 10px;
        margin-left: 35px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .video-attachment video {
        max-width: 300px;
        border-radius: 8px;
    }

    .file-attachment {
        padding: 8px 12px;
        background: #f0f0f0;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .image-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        cursor: pointer;
    }

        .image-modal img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }


    .message-header {
        margin-bottom: 5px;
    }

        .message-header .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
        }

    .message-item {
        display: flex;
        flex-direction: column;
        margin-bottom: 10px;
    }

    .message-content {
        margin-left: 35px;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.3/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chathub")
        .withAutomaticReconnect()
        .build();

    connection.start().then(() => {
        console.log("SignalR Connected");
        joinGroups();
        loadExistingMessages();
    }).catch(err => console.error("SignalR Connection Error:", err));

    function joinGroups() {
        document.querySelectorAll(".chat-container").forEach(container => {
            let groupId = container.querySelector(".send-btn").getAttribute("onclick").match(/\d+/)[0];
            connection.invoke("JoinGroup", parseInt(groupId))
                .catch(err => console.error("JoinGroup error:", err));
        });
    }

    function loadExistingMessages() {
        document.querySelectorAll(".chat-container").forEach(container => {
            let groupId = container.querySelector(".send-btn").getAttribute("onclick").match(/\d+/)[0];
            fetch(`/GroupFormation/GetMessages?groupId=${groupId}`)
                .then(response => response.json())
                .then(messages => {
                    let chatBox = document.getElementById("chatMessages-" + groupId);
                    chatBox.innerHTML = "";
                    messages.sort((a, b) => new Date(a.sentAt) - new Date(b.sentAt));
                    messages.forEach(msg => displayMessage(msg, chatBox));
                })
                .catch(err => console.error("Error loading messages:", err));
        });
    }

    function displayMessage(msg, chatBox) {
        const messageElement = document.createElement("div");
        messageElement.className = "message-item";
        messageElement.setAttribute('data-message-id', msg.messageId || Date.now());

        // Ensure proper handling of image URL
        let userImage;
        if (msg.userImageUrl && msg.userImageUrl.trim() !== '') {
            userImage = msg.userImageUrl.includes('UserFile')
                ? msg.userImageUrl
                : `/UserFile/${msg.userImageUrl}`;
        } else {
            userImage = '/UserFile/default-profile.jpg';
        }

        let messageHtml = `
            <div class="message-header">
                <img src="${userImage}" alt="${msg.userName}" class="user-avatar" title="${msg.userName} - ${new Date(msg.sentAt).toLocaleString()}" />
            </div>`;

        if (msg.messageText && msg.messageText.trim() !== '') {
            messageHtml += `<div class="message-content">${msg.messageText}</div>`;
        }

        if (msg.attachment) {
            const attachments = msg.attachment.split(',').filter(a => a.trim());
            if (attachments.length > 0) {
                let attachmentsHtml = '<div class="message-attachments">';
                attachments.forEach(attachment => {
                    const fileExt = attachment.toLowerCase().split('.').pop();
                    if (['jpg', 'jpeg', 'png', 'gif'].includes(fileExt)) {
                        attachmentsHtml += `
                            <div class="image-attachment">
                                <div class="image-actions">
                                    <a href="${attachment}" download title="Download" class="action-btn">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <button onclick="deleteAttachment(this, '${attachment}')" title="Delete" class="action-btn">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                <img src="${attachment}" alt="Image" onclick="openImageModal(this.src)" />
                            </div>`;
                    } else if (['mp4', 'webm', 'ogg'].includes(fileExt)) {
                        attachmentsHtml += `
                            <div class="video-attachment">
                                <video controls>
                                    <source src="${attachment}" type="video/${fileExt}">
                                    Your browser does not support the video tag.
                                </video>
                            </div>`;
                    } else {
                        attachmentsHtml += `
                            <div class="file-attachment">
                                <a href="${attachment}" target="_blank" download>
                                    <i class="fas fa-file"></i> ${attachment.split('/').pop()}
                                </a>
                            </div>`;
                    }
                });
                attachmentsHtml += '</div>';
                messageHtml += attachmentsHtml;
            }
        }

        messageElement.innerHTML = messageHtml;
        chatBox.appendChild(messageElement);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    async function deleteAttachment(button, attachmentPath) {
        if (!confirm('Are you sure you want to delete this image?')) return;

        try {
            const response = await fetch('/GroupFormation/DeleteAttachment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ path: attachmentPath })
            });

            if (response.ok) {
                button.closest('.image-attachment').remove();
            } else {
                alert('Failed to delete the image');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Failed to delete the image');
        }
    }

    document.querySelectorAll('.file-input').forEach(input => {
        input.addEventListener('change', function() {
            const fileCount = this.files.length;
            const countSpan = this.previousElementSibling.querySelector('.file-count');
            countSpan.style.display = fileCount > 0 ? 'block' : 'none';
            countSpan.textContent = fileCount || '';
        });
    });

    async function sendMessage(groupId) {
        const messageInput = document.getElementById(`messageInput-${groupId}`);
        const fileInput = document.getElementById(`fileInput-${groupId}`);
        const message = messageInput.value.trim();
        const files = fileInput.files;

        if (!message && files.length === 0) return;

        const formData = new FormData();
        formData.append('messageText', message || '');
        formData.append('groupId', groupId);

        Array.from(files).forEach(file => {
            formData.append('files', file);
        });

        try {
            const response = await fetch('/GroupFormation/SendMessage', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) throw new Error('Failed to send message');

            messageInput.value = '';
            fileInput.value = '';
            const countSpan = fileInput.previousElementSibling.querySelector('.file-count');
            if (countSpan) {
                countSpan.style.display = 'none';
                countSpan.textContent = '';
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Failed to send message. Please try again.');
        }
    }

    document.querySelectorAll('[id^="messageInput-"]').forEach(input => {
        input.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const groupId = this.id.split('-')[1];
                sendMessage(groupId);
            }
        });
    });

    connection.on("ReceiveMessage", function (groupId, userName, message, attachments, timestamp, imageUrl) {
        const chatBox = document.getElementById(`chatMessages-${groupId}`);
        if (!chatBox) return;

        // Ensure proper handling of image URL for received messages
        let userImage;
        if (imageUrl && imageUrl.trim() !== '') {
            userImage = imageUrl.includes('UserFile')
                ? imageUrl
                : `/UserFile/${imageUrl}`;
        } else {
            userImage = '/UserFile/default-profile.jpg';
        }

        displayMessage({
            userName: userName,
            messageText: message,
            attachment: attachments,
            sentAt: timestamp,
            userImageUrl: userImage
        }, chatBox);
    });

    function openImageModal(src) {
        const modal = document.createElement('div');
        modal.className = 'image-modal';
        modal.onclick = () => modal.remove();
        modal.innerHTML = `<img src="${src}" alt="Full size image">`;
        document.body.appendChild(modal);
    }
</script>