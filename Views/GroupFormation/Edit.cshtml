@model GuideMe.Models.Group

@{
    ViewData["Title"] = "Edit Group";
}
<head>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>

<form asp-action="Edit" enctype="multipart/form-data" method="post" style="max-width: 600px; margin: 0 auto; padding: 15px 20px; background-color: #f9f9f9; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">

    <h2 style="text-align: center; color: #4b8f8c; margin-bottom: 20px; font-size: 1.5rem;">Edit Group</h2>

    <input type="hidden" asp-for="GroupId" />

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Name" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-users" style="margin-right: 10px; color: #4b8f8c;"></i> Group Name
        </label>
        <input type="text" asp-for="Name" class="form-control group-location" style="width: 100%; padding: 12px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Location" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-map-marker-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Location
        </label>
        <input type="text" asp-for="Location" class="form-control group-location" style="width: 100%; padding: 12px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="TravelStartDate" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-calendar-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Travel Start Date
        </label>
        <input type="date" asp-for="TravelStartDate" class="form-control" style="width: 100%; padding: 12px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="TravelEndDate" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-calendar-alt" style="margin-right: 10px; color: #4b8f8c;"></i> Travel End Date
        </label>
        <input type="date" asp-for="TravelEndDate" class="form-control" style="width: 100%; padding: 12px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box;" required />
    </div>

    <div class="form-group" style="margin-bottom: 20px;">
        <label for="Description" style="font-size: 1rem; color: #333; display: flex; align-items: center;">
            <i class="fas fa-comment-dots" style="margin-right: 10px; color: #4b8f8c;"></i> Description
        </label>
        <textarea asp-for="Description" class="form-control" style="width: 100%; padding: 12px; font-size: 0.9rem; border-radius: 5px; border: 1px solid #ccc; margin-top: 8px; box-sizing: border-box; resize: vertical; min-height: 100px;" rows="4" required></textarea>
    </div>

    <div class="form-group mt-3" style="display: flex; gap: 10px; justify-content: space-between;">
        <button type="submit" class="btn btn-primary" style="padding: 10px 20px; font-size: 1rem; border-radius: 5px; text-align: center; text-decoration: none; display: inline-flex; align-items: center; background-color: #4b8f8c; color: white; border: none; cursor: pointer; width: 48%;">
            <i class="fas fa-save" style="margin-right: 5px;"></i> Save Changes
        </button>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 10px 20px; font-size: 1rem; border-radius: 5px; text-align: center; text-decoration: none; display: inline-flex; align-items: center; background-color: #ccc; color: #333; border: none; width: 48%;">
            <i class="fas fa-times-circle" style="margin-right: 5px;"></i> Cancel
        </a>
    </div>
</form>
