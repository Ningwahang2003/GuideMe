@model GuideMe.Models.Group

@{
    ViewData["Title"] = "Edit Group";
}

<h2>Edit Group</h2>

<form asp-action="Edit" enctype="multipart/form-data"  method="post">
    <input type="hidden" asp-for="GroupId" />

    <div class="form-group">
        <label for="Name">Group Name</label>
        <input type="text" asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Location">Location</label>
        <input type="text" asp-for="Location" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="TravelStartDate">Travel Start Date</label>
        <input type="date" asp-for="TravelStartDate" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="TravelEndDate">Travel End Date</label>
        <input type="date" asp-for="TravelEndDate" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

