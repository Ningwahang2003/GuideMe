@model GuideMe.Models.Province

<link rel="stylesheet" href="~/css/provincecontribution.css" asp-append-version="true" />

<div class="container">

    <h2 class="header">@Model.ProvinceName</h2>

    <!-- Contributions List -->
    <div class="row">
        @if (Model.UrbanTreasures.Any())
        {
            @foreach (var contribution in Model.UrbanTreasures)
            {
                        <div class="list">
                            <div class="card">
                        <div class="card-header">
                            <div class="user-info">
                                <img src="@Url.Content(string.IsNullOrEmpty(contribution.User.UserImage) ? "~/UserFile/default-profile.png" : $"~/UserFile/{contribution.User.UserImage}")"
                                     class="user-avatar" alt="User Avatar">
                                <span class="username">@contribution.User.Name</span>
                            </div>
                        </div>
                                <div class="scroll-container">
                                    @foreach (var img in contribution.Image.Split(','))
                                    {
                                        <img src="@Url.Content("~/UrbanImage/" + img)" class="image" alt="Contribution Image">
                                    }

                                    <div class="overlay" id="overlay">
                                        <span class="close-btn" id="close-btn">&times;</span>
                                        <img id="enlarged-image" class="enlarged" alt="Enlarged Contribution Image">
                                    </div>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">@contribution.Title</p>
                                    <p class="card-text">@contribution.Location</p>
                                    <p class="card-text">@contribution.Description</p>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-controller="Admin" asp-action="DeleteUrbanTreasure" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this post?');">
                                            <input type="hidden" name="id" value="@contribution.UrbanTreasureId" />
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fas fa-trash"></i> Delete Post
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
            }
        }
        else
        {
                <div class="col-12">
                    <p class="text-center">No contributions available for this province yet.</p>
                </div>
        }
    </div>

    <!-- Back Button -->
    <div class="contribution-button">
        <a asp-action="UrbanTreasures">Back to Provinces</a>
    </div>
</div>

<script>
    const overlay = document.getElementById('overlay');
    const enlargedImage = document.getElementById('enlarged-image');
    const closeBtn = document.getElementById('close-btn');

    document.querySelectorAll('.scroll-container img').forEach(img => {
        img.addEventListener('click', function () {
            enlargedImage.src = this.src;
            overlay.style.display = 'flex';
        });
    });

    closeBtn.addEventListener('click', function () {
        overlay.style.display = 'none';
    });
</script>

