@using System.Security.Claims
@model List<GuideMe.Models.UserPost>

@{
    ViewData["Title"] = "My Posts";
}

<link rel="stylesheet" href="~/css/getuserpost.css" asp-append-version="true" />

<div class="posts-page">
    <h2>My Posts</h2>

    <a asp-action="CreatePost" asp-controller="UserContent" class="create-post-btn">Create New Post</a>

    @if (!Model.Any())
    {
        <p class="no-posts">You haven't posted anything yet. <a asp-action="CreatePost" asp-controller="UserContent">Create your first post</a>!</p>
    }
    else
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        <div class="posts-container">
            <div class="posts-scroll">
                @foreach (var post in Model)
                {
                    bool hasLiked = post.PostLikes.Any(l => l.UserId.ToString() == userId);
                    <div class="post-card">
                        <div class="post-header">
                            <strong>@post.User?.Name</strong>
                            <span class="post-date">@post.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>

                        <div class="post-media-container">
                            @foreach (var mediaPath in post.MediaPath.Split(',').Where(mp => !string.IsNullOrEmpty(mp)))
                            {
                                if (mediaPath.EndsWith(".mp4") || mediaPath.EndsWith(".mov") || mediaPath.EndsWith(".avi"))
                                {
                                    <video controls class="post-media">
                                        <source src="@mediaPath" type="video/mp4">
                                    </video>
                                }
                                else
                                {
                                    <img src="@mediaPath" alt="Post Image" class="post-media" />
                                }
                            }
                        </div>

                        <div class="post-content">
                            <div class="action-buttons">
                                <button class="like-btn @(hasLiked ? "liked" : "")" data-post-id="@post.PostId">
                                    @(hasLiked ? "❤️" : "🤍")
                                </button>
                                <button class="comment-btn" data-post-id="@post.PostId">💬</button>
                            </div>

                            <p class="like-count"><span id="like-count-@post.PostId">@post.PostLikes.Count()</span> likes</p>
                            <p class="caption"><strong>Caption:</strong> @post.Caption</p>

                            <div class="comments-section">
                                <ul id="comment-list-@post.PostId">
                                    @foreach (var comment in post.UserComments.OrderByDescending(c => c.CreatedAt))
                                    {
                                        <li><strong>@comment.User?.Name</strong> @comment.Content</li>
                                    }
                                </ul>
                            </div>

                            <div class="comment-form">
                                <textarea class="comment-content" data-post-id="@post.PostId" placeholder="Add a comment..." required></textarea>
                                <button class="post-comment-btn" data-post-id="@post.PostId">Post</button>
                            </div>

                            @if (post.UserId == Convert.ToInt32(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value))
                            {
                                <form asp-action="DeletePost" asp-controller="UserContent" asp-route-id="@post.PostId" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this post?');">
                                    <button type="submit" class="delete-btn">Delete</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Like button 
        $(document).on("click", ".like-btn", function () {
            var button = $(this);
            var postId = button.data("post-id");
            $.post("/UserContent/LikePost", { postId: postId }, function (res) {
                if (res.success) {
                    $("#like-count-" + postId).text(res.likeCount);
                    button.text(res.isLiked ? "❤️" : "🤍").toggleClass("liked");
                }
            }).fail(function () {
                alert("Failed to process like.");
            });
        });

        // Comment section shower
        $(document).on("click", ".comment-btn", function() {
            var postId = $(this).data("post-id");
            var commentsSection = $("#comment-list-" + postId).closest('.comments-section');
            var commentForm = commentsSection.siblings('.comment-form');

            commentsSection.toggleClass('show');
            commentForm.toggleClass('show');
        });

        // comment button
        $(document).on("click", ".post-comment-btn", function () {
            var button = $(this);
            var postId = button.data("post-id");
            var content = $(".comment-content[data-post-id='" + postId + "']").val();

            if (!content) {
                alert("Please enter a comment.");
                return;
            }

            $.post("/UserContent/CommentPost", { postId: postId, content: content }, function (res) {
                if (res.success) {
                    $("#comment-list-" + postId).prepend(
                        `<li><strong>${res.userName}</strong> ${res.content}</li>`
                    );
                    $(".comment-content[data-post-id='" + postId + "']").val("");
                }
            }).fail(function () {
                alert("Failed to add comment.");
            });
        });
    });
</script>
