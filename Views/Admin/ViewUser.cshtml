@model IEnumerable<GuideMe.Models.User>

<link rel="stylesheet" href="~/css/viewuser.css" />

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List</title>
</head>
<body>
    <div class="container">
        <h1>User List</h1>
        <table>
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Password</th>
                    <th>User Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                        <td>@user.Password</td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.UserImage))
                            {
                                <img src="~/UserFile/@user.UserImage" alt="User Image" asp-append-version="true" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>
                            <button type="button" onclick="openForm(@user.UserId)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="overlay" class="overlay" onclick="closeForm()"></div>

    @foreach (var user in Model)
    {
        <div id="edit-form-@user.UserId" class="edit-form">
            <form asp-action="UpdateUser" asp-controller="Admin" method="post" enctype="multipart/form-data">
                <h3>Edit User</h3>
                <input type="hidden" name="UserId" value="@user.UserId" />

                <label for="Name">Name</label>
                <input type="text" name="Name" value="@user.Name" required />

                <label for="Email">Email</label>
                <input type="email" name="Email" value="@user.Email" required />

                <label for="UserFile">User Image</label>
                <input type="file" name="UserFile" />

                <button type="submit">Update</button>

            </form>

        </div>
    }

    <script>
        function openForm(userId) {
            document.getElementById(`edit-form-${userId}`).style.display = 'block';
            document.getElementById('overlay').style.display = 'block';
        }

        function closeForm() {
            var forms = document.getElementsByClassName('edit-form');
            for (var i = 0; i < forms.length; i++) {
                forms[i].style.display = 'none';
            }
            document.getElementById('overlay').style.display = 'none';
        }
    </script>
</body>
</html>
