@model IEnumerable<GuideMe.Models.WeeklyContest>

@{
    ViewData["Title"] = "View Weekly Contests";
}

<link rel="stylesheet" href="~/css/weeklycontest.css" asp-append-version="true" />

<div class="weeklycontest">
    <div class="header-section">
        <h2>Weekly Contests</h2>
        <a asp-action="AddContest" class="add-contest-btn">Add New Contest</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Contest Type</th>
                <th>Instructions</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contest in Model)
            {
                <tr>
                    <td>@contest.ContestType</td>
                    <td>@contest.Instructions</td>
                    <td>@contest.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@contest.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@contest.Status</td>
                    <td>
                        <form asp-action="DeleteContest" asp-route-id="@contest.ContestId" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this contest?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
