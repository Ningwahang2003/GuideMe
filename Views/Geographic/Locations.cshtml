@model List<GuideMe.Models.Location>
@using System.Linq

<link rel="stylesheet" href="~/css/location.css" asp-append-version="true" />

<video autoplay loop muted playsinline id="background-video">
    <source src="~/Video/map.mp4" type="video/mp4">
    Your browser does not support the video tag.
</video>

<div class="location-container">
    <h2>Location Search</h2>


    <!-- Recommendations panel -->
    <div class="side-recommendations">
        @{
            var recommendations = ViewBag.Recommendations as List<Location>;
            var userLocation = ViewBag.UserLocation as Location;
        }
        @if (recommendations != null && recommendations.Any())
        {
            <div class="recommendation-panel">
                @if (userLocation != null)
                {
                    <div class="last-search">
                        <h4><i class="fas fa-history"></i> Your Last Search</h4>
                        <div class="last-search-card">
                            <div class="last-search-name">@userLocation.LocationName</div>
                            <div class="last-search-time">
                                <i class="fas fa-clock"></i> @userLocation.LocationCreatedAt?.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                }

                <h4><i class="fas fa-star"></i> Recommended Places</h4>
                @foreach (var rec in recommendations)
                {
                    <div class="rec-card @(userLocation?.LocationName == rec.LocationName ? "highlight" : "")"
                         onclick="setLocation('@rec.LocationName')">
                        <div class="rec-name">@rec.LocationName</div>
                        @if (userLocation != null)
                        {
                            var distance = rec.GetDistanceTo(userLocation);
                            <div class="rec-distance">
                                <i class="fas fa-map-marker-alt"></i>
                                @(Math.Round(distance, 1)) km away
                            </div>
                        }
                        <div class="rec-stats">
                            <i class="fas fa-search"></i> @rec.SearchCount searches
                        </div>
                    </div>
                }
            </div>
        }
    </div>


    <form method="get" action="@Url.Action("Locations", "Geographic")">
        <input type="text" id="search" name="search" placeholder="Enter a city or address" required />
        <button type="submit">Search</button>
    </form>

    <div class="results">
        <h2>Search Results</h2>

        @if (Model != null && Model.Any())
        {
            @foreach (var location in Model)
            {
                <div class="result-item">
                    @location.LocationName
                    <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=@(location.Longitude-0.05),@(location.Latitude-0.05),@(location.Longitude+0.05),@(location.Latitude+0.05)&layer=mapnik"
                            width="100%"
                            height="600px"
                            frameborder="0"
                            style="border:0"
                            allowfullscreen>
                    </iframe>
                </div>
            }
        }
        else
        {
            <p class="no-results">No locations found.</p>
        }
    </div>
</div>

<script>
    function setLocation(name) {
        document.getElementById('search').value = name;
    }
</script>
