@model List<GuideMe.Models.UserViewModel>

@{
    ViewData["Title"] = "Chat";
    var userId = User.Identity?.Name;
}

<div class="container mt-5">
    <div class="row">
        <!-- Left Sidebar -->
        <div class="col-md-4">
            <div class="search-container mb-4">
                <input type="text" id="searchUser" class="form-control" placeholder="Search users..." />
                <button class="btn btn-primary" onclick="searchUsers()">Search</button>
            </div>

            <h5>Chat History</h5>
            <ul id="userList" class="list-group">
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <li class="list-group-item">
                            <a href="@Url.Action("GetChatHistory", "Chat", new { userId = userId, otherUserId = user.UserId })">
                                @if (!string.IsNullOrEmpty(user.UserImage))
                                {
                                    <img src="@user.UserImage" class="img-thumbnail" width="30" height="30" alt="@user.Name" />
                                }
                                @user.Name
                            </a>

                            @if (user.Messages != null && user.Messages.Any())
                            {
                                var latestMessage = user.Messages.First();
                                <small class="text-muted">@latestMessage.SentAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                <div>@latestMessage.MessageText</div>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">No users available</li>
                }
            </ul>
        </div>

        <!-- Right Side -->
        <div class="col-md-8">
            @if (Model != null && Model.Any())
            {
                <h3>Chat with @Model[0].Name</h3>
                <div id="chatBox" class="mb-3" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px;">
                    <div class="messages">
                        @if (Model[0].Messages != null)
                        {
                            @foreach (var message in Model[0].Messages)
                            {
                                <div class="message mb-3">
                                    <div class="message-header">
                                        <strong>@(message.User?.Name ?? "Unknown User"):</strong>
                                        <small class="text-muted">@message.SentAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                    </div>
                                    <div class="message-body">
                                        @message.MessageText
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(userId))
                {
                    <form method="post" action="/Chat/SendPrivateMessage">
                        <input type="hidden" name="senderId" value="@userId" />
                        <input type="hidden" name="receiverId" value="@Model[0].UserId" />
                        <div class="form-group">
                            <textarea name="message" class="form-control" placeholder="Type a message..." rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                }
            }
            else
            {
                <p>Select a user to start chatting</p>
            }
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.3/signalr.min.js"></script>
    <script>
        // Establish SignalR connection
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceivePrivateMessage", function(senderId, message) {
            var messageContainer = document.getElementById("chatBox");
            var newMessage = document.createElement("div");
            newMessage.innerHTML = "<strong>User " + senderId + ":</strong> " + message;
            messageContainer.appendChild(newMessage);
        });

        connection.start().catch(function(err) {
            return console.error(err.toString());
        });
    </script>
}
