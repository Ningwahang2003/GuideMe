@using System.Security.Claims
@{
    ViewData["Title"] = "Chat";
}
<link rel="stylesheet" href="~/css/individualchatroom.css" asp-append-version="true" />

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Left sidebar -->
        <div class="col-md-5">
            <!-- Search box -->
            <div class="search-container">
                <form asp-action="SearchUsers" asp-controller="Chat" method="get">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search users by name..." required>
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
                @if (TempData["SearchError"] != null)
                {
                    <div class="search-error-message">
                        @TempData["SearchError"]
                    </div>
                }
            </div>

            <!-- Search Results -->
            <div id="searchResults" class="list-group mt-3">
                @if (ViewBag.SearchResults != null)
                {
                    foreach (var user in ViewBag.SearchResults)
                    {
                        @if (user.Role == "User")
                        {
                            <div class="user-item d-flex align-items-center p-2 border-bottom" data-user-id="@user.UserId">
                                <img src="@(!string.IsNullOrEmpty(user.UserImage) ? $"/UserFile/{user.UserImage}" : "/UserFile/default-profile.png")"
                                     class="rounded-circle mr-2"
                                     style="width: 40px; height: 40px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="font-weight-bold">@user.Name</div>
                                        <button type="button" class="close-search btn btn-link p-0 ml-2" aria-label="Close">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Chat Users List -->
            <div id="chatUsersList" class="list-group mt-3"></div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-7">
            <div class="chat-container d-none">
                <div class="chat-header d-flex align-items-center">
                    <img id="selectedUserImage" src="/UserFile/default-profile.png" class="rounded-circle mr-2" style="width: 40px; height: 40px;">
                    <h5 id="selectedUserName" class="mb-0"></h5>
                </div>
                <div id="messageArea" class="messages-area">
                    <!-- Messages will be loaded here -->
                </div>
                <div class="chat-input-area">
                    <div class="d-flex align-items-center">
                        <div class="input-group">
                            <input type="text" id="messageInput" class="form-control" placeholder="Type your message...">
                            <div class="input-group-append">
                                <button type="button" id="sendButton" class="btn btn-primary">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="currentUserId" value="@User.FindFirstValue(ClaimTypes.Name)" />
<input type="hidden" id="currentUserImage" value="@ViewBag.CurrentUserImage" />


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.3/signalr.min.js"></script>
<script>
    let selectedUserId = null;
    let selectedUserName = null;
    let connection = null;

    function setupSignalR() {
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceivePrivateMessage", function (senderId, senderName, message, timestamp, senderImage) {
            const currentUserId = parseInt($('#currentUserId').val());

            // Update chat for both sender and receiver
            if (selectedUserId === senderId || senderId === currentUserId) {
                appendMessage(message, timestamp, senderId !== currentUserId, senderImage);
                updateChatUsersList(); // Update the chat list to show latest message
            }
        });

        connection.start()
            .then(function() {
                console.log("SignalR Connected");
            })
            .catch(function (err) {
                console.error(err.toString());
                setTimeout(setupSignalR, 5000); // Retry connection
            });
    }

        function updateChatUsersList() {
        $.get('/Chat/GetChatUsers', function (users) {
            const chatUsersList = $('#chatUsersList');
            chatUsersList.empty();

            users.forEach(item => {
                const lastMessagePreview = item.lastMessage
                    ? `<small class="text-muted">${item.lastMessage.messageText.substring(0, 20)}${item.lastMessage.messageText.length > 20 ? '...' : ''}</small>`
                    : '';

                const userImagePath = item.user.userImage
                    ? `/UserFile/${item.user.userImage}`
                    : '/UserFile/default-profile.png';

                const userHtml = `
                    <div class="user-item d-flex align-items-center p-2 border-bottom ${selectedUserId === item.user.userId ? 'active' : ''}"
                         data-user-id="${item.user.userId}">
                        <img src="${userImagePath}"
                             class="rounded-circle mr-2"
                             style="width: 40px; height: 40px; object-fit: cover;">
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <strong>${item.user.name}</strong>
                            </div>
                            ${lastMessagePreview}
                        </div>
                    </div>
                `;
                chatUsersList.append(userHtml);
            });

            attachUserClickHandlers();
        });
    }

        function attachUserClickHandlers() {
        $('.user-item').click(function () {
            selectedUserId = $(this).data('user-id');
            selectedUserName = $(this).find('strong').text();
            const selectedUserImage = $(this).find('img').attr('src');

            $('.user-item').removeClass('active');
            $(this).addClass('active');

            $('#selectedUserName').text(selectedUserName);
            $('#selectedUserImage').attr('src', selectedUserImage);
            $('.chat-container').removeClass('d-none');

            loadMessages(selectedUserId);
        });
    }

        function loadMessages(userId) {
        $.get(`/Chat/GetPrivateMessages?userId=${userId}`, function (messages) {
            const messageArea = $('#messageArea');
            messageArea.empty();

            messages.forEach(message => {
                const isReceived = message.senderId !== parseInt($('#currentUserId').val());
                const userImage = isReceived
                    ? $('#selectedUserImage').attr('src')
                    : $('#currentUserImage').val() ? `/UserFile/${$('#currentUserImage').val()}` : '/UserFile/default-profile.png';

                appendMessage(message.messageText, message.sentAt, isReceived, userImage);
            });

            scrollToBottom();
        });
    }

       function appendMessage(message, timestamp, isReceived, userImage) {
        const messageArea = $('#messageArea');
        const messageClass = isReceived ? 'received' : 'sent';
        const alignClass = isReceived ? 'justify-content-start' : 'justify-content-end';

        // Only user image per message
        const messageHtml = `
            <div class="message-row d-flex ${alignClass} mb-2">
                ${isReceived ? `<img src="${userImage}" class="rounded-circle mr-2" style="width: 30px; height: 30px; object-fit: cover;">` : ''}
                <div class="message ${messageClass} p-2 rounded">
                    <div class="message-content">${message}</div>
                    <small class="text-muted">${new Date(timestamp).toLocaleTimeString()}</small>
                </div>
            </div>
        `;

        messageArea.append(messageHtml);
        scrollToBottom();
    }

    function sendMessage() {
        const messageInput = $('#messageInput');
        const message = messageInput.val().trim();

        if (!message || !selectedUserId || !connection) return;

        const senderId = parseInt($('#currentUserId').val());

        connection.invoke("SendPrivateMessage", senderId, selectedUserId, message)
            .then(function() {
                messageInput.val('');
            })
            .catch(function(err) {
                console.error(err.toString());
                alert("Failed to send message. Please try again.");
            });
    }

    function scrollToBottom() {
        const messageArea = $('#messageArea');
        messageArea.scrollTop(messageArea[0].scrollHeight);
    }

    function startAutoRefresh() {
        setInterval(function() {
            if (selectedUserId) {
                loadMessages(selectedUserId);
            }
            updateChatUsersList();
        }, 5000);
    }

    $(document).ready(function() {
        setupSignalR();
        updateChatUsersList();
        startAutoRefresh();

        $('#messageInput').keypress(function(e) {
            if (e.which == 13 && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        $('#sendButton').click(function(e) {
            e.preventDefault();
            sendMessage();
        });

        // Adding handler for close button
        $(document).on('click', '.close-search', function(e) {
            e.stopPropagation();
            $(this).closest('.user-item').remove();

            // Hiding the container if no  user
            if ($('#searchResults .user-item').length === 0) {
                $('#searchResults').empty();
            }
        });
    });
</script>