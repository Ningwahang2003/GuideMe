@model UserEdit
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-image: url('../Image/userupdate.jpg');
        background-size: cover;
        background-position: center;
        color: #333;
        line-height: 1.6;
        min-height: 100vh;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        max-width: 1000px;
        margin: 20px auto;
        padding: 30px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-right: 60px;
        padding: 20px;
        background: transparent;
        border-radius: 15px;
        box-shadow: none;
    }

    .form {
        display: flex;
        flex-direction: column;
        width: 500px;
        padding: 25px;
        background: transparent;
        box-shadow: none;
    }

        /* Add a separator between profile and form */
        .form::before {
            content: '';
            position: absolute;
            left: -30px;
            top: 50%;
            transform: translateY(-50%);
            height: 80%;
            width: 1px;
            background: rgba(0, 0, 0, 0.1);
        }

    input[type="text"],
    input[type="email"],
    input[type="file"] {
        width: 100% !important;
        box-sizing: border-box;
        padding: 14px;
        margin-top: 12px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 16px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.9);
    }



        .profile img {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 4px solid #fff;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

            .profile img:hover {
                transform: scale(1.05);
            }

        .profile h1 {
            margin-bottom: 10px;
            font-size: 32px;
            color: #2563eb;
            font-weight: 600;
        }

        .profile p {
            font-size: 18px;
            color: #4b5563;
        }

    

        input[type="text"]:focus,
        input[type="email"]:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            outline: none;
        }

    input[type="file"] {
        border: 2px dashed #2563eb;
        background: rgba(37, 99, 235, 0.05);
        cursor: pointer;
        padding: 20px;
    }

    input[type="submit"] {
        padding: 14px 30px;
        background: linear-gradient(145deg, #2563eb, #1d4ed8);
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 20px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

        input[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3);
            background: linear-gradient(145deg, #1d4ed8, #1e40af);
        }

    .relative {
        position: relative;
        margin-bottom: 25px;
        width: 100%;
    }

    label {
        position: absolute;
        top: -10px;
        left: 15px;
        padding: 0 5px;
        font-size: 14px;
        color: #2563eb;
        background: white;
        font-weight: 500;
    }
</style>

<div class="container">
    <div class="profile">
        <img class="max-w-4 h-44 mb-3 rounded-full shadow-lg" src="~/UserFile/@Model.UserImage" />
        <h1 class="mb">@Model.Name</h1>
        <p class="mb">@Model.Email</p>
    </div>

    <div class="form">
        <form asp-action="ProfileUpdate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly"></div>
            <input asp-for="UserId" hidden />
            <input asp-for="UserImage" hidden />
            <input asp-for="Role" hidden />
            <input asp-for="Password" hidden />

            <div class="relative">
                <label asp-for="Name" class="absolute"></label>
                <input asp-for="Name" type="text" placeholder="Name" />
            </div>

            <div class="relative">
                <label asp-for="Email" class="absolute"></label>
                <input asp-for="Email" type="email" placeholder="Email" />
            </div>

            <div class="relative">
                <label asp-for="UserFile" class="absolute"></label>
                <input asp-for="UserFile" type="file" />
            </div>

            <div class="mb-2">
                <input type="submit" value="Update" />
            </div>
        </form>
    </div>
</div>
