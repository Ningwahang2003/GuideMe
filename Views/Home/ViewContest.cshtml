@model IEnumerable<GuideMe.Models.ContestEntry>

<link rel="stylesheet" href="~/css/viewcontest.css" asp-append-version="true" />
@{
    ViewBag.Title = "Contest Participants";
    var isAdmin = User.IsInRole("Admin");
}

<h2>Contest Participants</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <p>No participants found for this contest.</p>
}
else
{
    <div class="table-responsive">
        @foreach (var entry in Model)
        {
            <div class="participant-card">
                <div class="user-info">
                    <img src="@(string.IsNullOrEmpty(entry.User?.UserImage) ? "/UserFile/default-profile.png" : $"/UserFile/{entry.User.UserImage}")"
                         alt="User Avatar"
                         class="user-avatar"
                         onerror="this.src='/UserFile/default-profile.png'" />
                    <h3 class="participant-name">@entry.User?.Name</h3>
                </div>
                <h3 class="participant-title">@entry.Title</h3>

                <div class="participant-images">
                    <div class="image-container">
                        @{
                            var imageFiles = entry.Submission.Split(new char[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                        }
                        @foreach (var image in imageFiles)
                        {
                            <div class="image-slide">
                                <img src="~/ContestSubmissions/@image" alt="Contest Image" class="participant-image" />
                            </div>
                        }
                    </div>

                    <p class="participant-description">@entry.Descriptions</p>
                </div>

                <div class="vote-section">
                    @if (isAdmin)
                    {
                        <p class="vote-count">Votes: @entry.VoteCount</p>
                    }

                    <form asp-action="Vote" method="post">
                        <input type="hidden" name="contestEntryId" value="@entry.ContestEntryId" />
                        <button type="submit" class="btn btn-primary">Vote</button>
                    </form>
                </div>
            </div>
        }
    </div>

}

<script>
    document.querySelectorAll('.participant-images').forEach(function(imageContainer) {
        var images = imageContainer.querySelectorAll('.participant-image');
        if (images.length > 1) {
            imageContainer.classList.add('has-multiple-images');
        }
    });
</script>

