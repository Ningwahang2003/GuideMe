@model GuideMe.Models.ContestEntry

<link rel="stylesheet" href="~/css/participatecontest.css" asp-append-version="true" />

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<form asp-action="ParticipateContest" asp-route-contestId="@Model.ContestId" enctype="multipart/form-data" method="post">

    <h2>Weekly Contest</h2>

    <label asp-for="Title"></label>
    <input asp-for="Title" required />

    <label for="ContestImages">Upload Files:</label>
    <input type="file" name="ContestImages" multiple accept="image/*" required />

    <label asp-for="Descriptions">Description:</label>
    <textarea asp-for="Descriptions" required></textarea>

    <button type="submit">Submit</button>
</form>
