@model GuideMe.Models.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/home.css" />

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessage">@TempData["SuccessMessage"]</div>
}

<div id="event-container">
    @foreach (var ev in Model.UpcomingEvents)
    {
        <div class="event-slide">
            <h3>@ev.EventTitle</h3>
            <p>@ev.EventDescription</p>
            <p><strong>Starts:</strong> @ev.EventStartDate?.ToString("yyyy-MM-dd")</p>
            <p><strong>Ends:</strong> @ev.EventEndDate?.ToString("yyyy-MM-dd")</p>
            <p><strong>Time:</strong> @ev.EventTime</p>
        </div>
    }
</div>

@{
    var today = DateTime.UtcNow.Date;
    var contest = Model.UpcomingContests.FirstOrDefault();
}
@if (Model.Winner != null && contest != null &&(today - contest.EndDate.Date).TotalDays <= 1 &&today > contest.EndDate.Date)
{
    <div class="winner-announcement mb-4">
        <h2>Last Week's Contest Winner! 🏆</h2>
        <div class="winner-card">
            <div class="winner-info">
                <h3>@Model.Winner.Name</h3>
                <p>Congratulations to our winner!</p>
                <div class="winning-entry mt-3">
                    <p><strong>Contest:</strong> @contest.ContestType</p>
                    @if (Model.ContestEntries.Any(e => e.UserId == Model.Winner.UserId))
                    {
                        var winningEntry = Model.ContestEntries.First(e => e.UserId == Model.Winner.UserId);
                        <p>@winningEntry.Title</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h2>Current Weekly Contest</h2>

    @if (Model.UpcomingContests.Any())
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@contest.ContestType</h5>
                <p><strong>Status:</strong> @contest.ContestPhase</p>
                <p><strong>Start Date:</strong> @contest.StartDate.ToString("MM/dd/yyyy")</p>
                <p><strong>End Date:</strong> @contest.EndDate.ToString("MM/dd/yyyy")</p>
                <p><strong>Instructions:</strong> @contest.Instructions</p>
                @if ((today - contest.StartDate.Date).TotalDays <= 1)
                {
                    <a href="@Url.Action("ParticipateContest", "Home", new { contestId = contest.ContestId })"
                       class="btn btn-primary">Participate</a>
                }
                else
                {
                    <p class="alert alert-info">Participation is closed</p>
                }
                <a href="@Url.Action("ViewContest", "Home", new { contestId = contest.ContestId })"
                   class="btn btn-secondary">View Entries</a>
            </div>
        </div>
    }
    else
    {
        <p>No active contests currently.</p>
    }
    
}


<h2>Latest User Posts</h2>

@if (Model.UserPosts?.Any() == true)
{
    <div class="row">
        @foreach (var post in Model.UserPosts)
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@post.User.Name</h5>
                    @foreach (var mediaPath in post.MediaPath.Split(',').Where(mp => !string.IsNullOrEmpty(mp)))
                    {
                        if (mediaPath.EndsWith(".mp4") || mediaPath.EndsWith(".mov") || mediaPath.EndsWith(".avi"))
                        {
                            <video controls class="post-media"><source src="@mediaPath" type="video/mp4"></video>
                        }
                        else
                        {
                            <img src="@mediaPath" alt="Post Image" class="post-media" />
                        }
                    }
                    <p>@post.Caption</p>
                    <p class="text-muted">Posted on: @post.CreatedAt.ToString("MMM dd, yyyy")</p>

                    <button class="btn btn-outline-primary like-btn" data-post-id="@post.PostId">Like (@post.PostLikes.Count)</button>
                    <textarea class="comment-content" data-post-id="@post.PostId" placeholder="Add a comment..." required></textarea>
                    <button class="btn btn-info comment-btn" data-post-id="@post.PostId">Comment</button>

                    <div>
                        <h6>Comments:</h6>
                        <ul id="comment-list-@post.PostId">
                            @foreach (var comment in post.UserComments)
                            {
                                <li><strong>@comment.User.Name:</strong> @comment.Content</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No posts available.</p>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        let slides = $('.event-slide');
        let currentIndex = 0;

        function showSlide(index) {
            slides.hide().eq(index).show();
        }

        function nextSlide() {
            currentIndex = (currentIndex + 1) % slides.length;
            showSlide(currentIndex);
        }

        if (slides.length > 0) {
            showSlide(currentIndex);
            setInterval(nextSlide, 3000);
        }

        $('#successMessage').fadeOut(3000);

        $(document).on('click', '.like-btn', function () {
            let button = $(this);
            let postId = button.data('post-id');
            $.post('/UserContent/LikePost', { postId: postId }, function (res) {
                if (res.success) {
                    button.text(`Like (${res.likeCount})`);
                }
            }).fail(() => alert('Failed to process like.'));
        });

        $(document).on('click', '.comment-btn', function () {
            let postId = $(this).data('post-id');
            let content = $(`.comment-content[data-post-id='${postId}']`).val();
            $.post('/UserContent/CommentPost', { postId: postId, content: content }, function (res) {
                if (res.success) {
                    $(`#comment-list-${postId}`).prepend(`<li><strong>${res.userName}:</strong> ${res.content}</li>`);
                    $(`.comment-content[data-post-id='${postId}']`).val('');
                }
            }).fail(() => alert('Failed to add comment.'));
        });
    });
</script>
