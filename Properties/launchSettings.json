    "iisSettings": {
        "windowsAuthentication": false,
        "anonymousAuthentication": true,
        "iisExpress": {
            "applicationUrl": "http://localhost:18972", // Changed to HTTP
            "sslPort": 44314
        }
    },
    "profiles": {
